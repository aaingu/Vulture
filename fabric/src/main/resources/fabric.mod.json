{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "Vulture",
	"description": "OptiFine-format shader packs, on Minecraft's native Vulkan renderer",
	"authors": [
		"aaingu",
		"avpbynf"
	],
	"credits": "Based on Vitrail Shaders by avpbynf",
	"contact": {
		"homepage": "https://github.com/aaingu/Vulture",
		"sources": "https://github.com/aaingu/Vulture",
		"issues": "https://github.com/aaingu/Vulture/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "vulture.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.vulture.fabric.VultureFabric"
		],
		"sodium:config_api_user": [
			"dev.vulture.sodium.ConfigEntry"
		]
	},
	"mixins": [
		"vulture.mixins.json",
		"vulture-game.mixins.json",
		"vulture-fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_min_version}",
		"minecraft": ">=${minecraft_version} <${minecraft_next}",
		"sodium": "0.9.x",
		"fabric-key-mapping-api-v1": "*",
		"fabric-lifecycle-events-v1": "*"
	},
	"custom": {
		"sodium:options": {
			"mixin.features.render.world.sky": false
		}
	}
}
